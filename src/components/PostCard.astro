---
import type { Locale } from '@lib/i18n';

export interface Props {
  title: string;
  slug: string;
  category: string;
  pubDate: Date;
  excerpt: string;
  readingTime?: number;
  locale: Locale;
  index?: number;
}

const { title, slug, category, pubDate, excerpt, readingTime, locale, index = 0 } = Astro.props;

const categoryLabels: Record<string, string> = {
  work: 'Work',
  learn: 'Learn',
  hobby: 'Hobby',
  life: 'Life',
};
const zhCategoryLabels: Record<string, string> = {
  work: '工作',
  learn: '学习',
  hobby: '爱好',
  life: '生活',
};

const categoryColors: Record<string, string> = {
  work: 'bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300',
  learn: 'bg-blue-50 text-blue-700 dark:bg-blue-950/50 dark:text-blue-300',
  hobby: 'bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300',
  life: 'bg-violet-50 text-violet-700 dark:bg-violet-950/50 dark:text-violet-300',
};

const delayClass = index < 3 ? `reveal-delay-${(index % 4) + 1}` : '';
---

<a
  href={`/${locale}/blog/${slug}`}
  class={`group block p-6 rounded-2xl border border-gray-200/70 dark:border-gray-800/70 bg-white dark:bg-gray-900/50 hover:border-primary-300/50 dark:hover:border-primary-700/50 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 reveal ${delayClass}`}
>
  <!-- Category tag -->
  <div class="flex items-center gap-2 mb-4">
    <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${categoryColors[category] ?? 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300'}`}>
      {locale === 'zh' ? (zhCategoryLabels[category] ?? category) : (categoryLabels[category] ?? category)}
    </span>
    {readingTime && (
      <span class="text-xs text-gray-400 dark:text-gray-500">{readingTime} min read</span>
    )}
  </div>

  <!-- Title -->
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors mb-2.5 line-clamp-2 leading-snug">
    {title}
  </h3>

  <!-- Excerpt -->
  <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-3 mb-4 leading-relaxed">
    {excerpt}
  </p>

  <!-- Date -->
  <time class="text-xs text-gray-400 dark:text-gray-500 font-mono" datetime={new Date(pubDate).toISOString()}>
    {new Date(pubDate).toLocaleDateString(locale === 'zh' ? 'zh-CN' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })}</time>
</a>
