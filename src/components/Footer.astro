---
import { t, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="border-t border-gray-200 dark:border-gray-800 py-8 mt-16">
  <div class="max-w-6xl mx-auto px-4 text-center text-sm text-gray-500 dark:text-gray-400">
    <p>&copy; {new Date().getFullYear()} eva9.ai — {t('footer.text', locale)}</p>
    <div class="flex justify-center gap-4 mt-2">
      <a href={`/${locale}/blog`} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">{t('nav.blog', locale)}</a>
      <a href={`/${locale}/about`} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">{t('nav.about', locale)}</a>
      <a href={`/${locale}/contact`} class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">{t('nav.contact', locale)}</a>
      <a href="/sitemap.xml" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Sitemap</a>
      <a href="/rss.xml" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">RSS</a>
    </div>
  </div>
</footer>
