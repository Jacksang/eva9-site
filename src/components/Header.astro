---
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const navItems = [
  { key: 'nav.home', path: `/${locale}` },
  { key: 'nav.portfolio', path: `/${locale}/portfolio` },
  { key: 'nav.services', path: `/${locale}/services` },
  { key: 'nav.studies', path: `/${locale}/studies` },
  { key: 'nav.blog', path: `/${locale}/blog` },
  { key: 'nav.about', path: `/${locale}/about` },
  { key: 'nav.contact', path: `/${locale}/contact` },
];
---

<header class="sticky top-0 z-50 bg-white/70 dark:bg-gray-950/70 backdrop-blur-xl border-b border-gray-200/60 dark:border-gray-800/60">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={`/${locale}`} class="flex items-center gap-2.5 font-semibold text-base tracking-tight text-gray-800 dark:text-gray-200 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
      <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-primary-600 dark:bg-primary-500 text-white text-sm font-bold">J</span>
      <span class="hidden sm:inline">jacky.chen</span>
    </a>

    <!-- Nav links (hidden on mobile) -->
    <ul class="hidden md:flex items-center gap-1">
      {navItems.map(item => (
        <li>
          <a
            href={item.path}
            class={`px-3 py-2 text-sm font-medium rounded-lg transition-all duration-150 ${
              currentPath === item.path
                ? 'bg-primary-50 dark:bg-primary-950/60 text-primary-700 dark:text-primary-300'
                : 'text-gray-500 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800/60'
            }`}
          >
            {t(item.key, locale)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right side actions -->
    <div class="flex items-center gap-1.5">
      <ThemeToggle />
      <LangSwitcher locale={locale} currentPath={currentPath} />
      <a
        href={`/${locale}/register`}
        class="hidden sm:inline-flex ml-1.5 px-3 py-1.5 text-sm font-medium rounded-lg text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-950/60 transition-colors"
      >
        {t('nav.register', locale)}
      </a>
      <a
        href={`/${locale}/login`}
        class="hidden sm:inline-flex px-3 py-1.5 text-sm font-medium rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 hover:border-primary-400 dark:hover:border-primary-500 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
      >
        {t('nav.login', locale)}
      </a>
      <a
        href={`/${locale}/admin`}
        class="hidden sm:inline-flex px-3 py-1.5 text-sm font-medium rounded-lg bg-primary-600 text-white hover:bg-primary-700 active:scale-[0.97] transition-all"
      >
        {t('nav.admin', locale)}
      </a>
    </div>
  </nav>

  <!-- Mobile nav (bottom bar) -->
  <div class="md:hidden border-t border-gray-200/60 dark:border-gray-800/60 flex justify-around py-2.5 bg-white dark:bg-gray-950">
    {navItems.map(item => (
      <a
        href={item.path}
        class={`text-xs font-medium px-2.5 py-1.5 rounded-md transition-colors ${
          currentPath === item.path
            ? 'text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-950/50'
            : 'text-gray-400 dark:text-gray-500'
        }`}
      >
        {t(item.key, locale)}
      </a>
    ))}
  </div>
</header>
