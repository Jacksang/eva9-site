---
import LangSwitcher from './LangSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import { t, type Locale } from '@lib/i18n';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const navItems = [
  { key: 'nav.home', path: `/${locale}` },
  { key: 'nav.blog', path: `/${locale}/blog` },
  { key: 'nav.about', path: `/${locale}/about` },
  { key: 'nav.contact', path: `/${locale}/contact` },
];
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-gray-950/80 backdrop-blur border-b border-gray-200 dark:border-gray-800">
  <nav class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
    <!-- Logo -->
    <a href={`/${locale}`} class="flex items-center gap-2 font-bold text-lg text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors">
      <span class="text-2xl">◈</span>
      <span class="hidden sm:inline">blog.eva9.ai</span>
    </a>

    <!-- Nav links (hidden on mobile) -->
    <ul class="hidden md:flex items-center gap-1">
      {navItems.map(item => (
        <li>
          <a
            href={item.path}
            class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
              currentPath === item.path
                ? 'bg-primary-50 dark:bg-primary-950 text-primary-700 dark:text-primary-300'
                : 'text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-800'
            }`}
          >
            {t(item.key, locale)}
          </a>
        </li>
      ))}
    </ul>

    <!-- Right side actions -->
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <LangSwitcher locale={locale} currentPath={currentPath} />
      <a
        href={`/${locale}/login`}
        class="hidden sm:inline-flex ml-2 px-3 py-1.5 text-sm rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 hover:border-primary-400 transition-colors font-medium"
      >
        {t('nav.login', locale)}
      </a>
      <a
        href={`/${locale}/admin`}
        class="hidden sm:inline-flex ml-1 px-3 py-1.5 text-sm rounded-lg bg-primary-600 text-white hover:bg-primary-700 transition-colors font-medium"
      >
        {t('nav.admin', locale)}
      </a>
    </div>
  </nav>

  <!-- Mobile nav (bottom bar) -->
  <div class="md:hidden border-t border-gray-200 dark:border-gray-800 flex justify-around py-2 bg-white dark:bg-gray-950">
    {navItems.map(item => (
      <a
        href={item.path}
        class={`text-xs font-medium px-2 py-1 rounded ${
          currentPath === item.path
            ? 'text-primary-600 dark:text-primary-400'
            : 'text-gray-500 dark:text-gray-400'
        }`}
      >
        {t(item.key, locale)}
      </a>
    ))}
  </div>
</header>
