---
import Base from '@layouts/Base.astro';
import type { Locale } from '@lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
---

<Base
  title={locale === 'zh' ? '联系我们' : 'Contact'}
  description={locale === 'zh' ? '联系 Jacky Chen' : 'Get in touch with Jacky Chen'}
  locale={locale}
>
  <section class="prose-container py-12">
    <h1 class="text-3xl font-bold mb-8 text-gray-900 dark:text-white">
      {locale === 'zh' ? '联系我们' : 'Get in Touch'}
    </h1>

    <form id="contact-form" class="max-w-lg space-y-6">
      <div>
        <label for="name" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">
          {locale === 'zh' ? '姓名' : 'Name'}
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition"
          placeholder={locale === 'zh' ? '你的名字' : 'Your name'}
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">
          {locale === 'zh' ? '邮箱' : 'Email'}
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition"
          placeholder="you@example.com"
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">
          {locale === 'zh' ? '留言' : 'Message'}
        </label>
        <textarea
          id="message"
          name="message"
          rows={5}
          required
          class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition resize-y"
          placeholder={locale === 'zh' ? '你的留言…' : 'Your message…'}
        ></textarea>
      </div>

      <div id="contact-status" class="hidden p-3 rounded-lg text-sm"></div>

      <button
        type="submit"
        class="px-6 py-3 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors disabled:opacity-50"
      >
        {locale === 'zh' ? '发送消息' : 'Send Message'}
      </button>
    </form>
  </section>
</Base>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('contact-status')!;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button')!;
    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const formData = new FormData(form);
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(formData)),
      });

      if (res.ok) {
        status.className = 'p-3 rounded-lg text-sm bg-green-50 dark:bg-green-900 text-green-700 dark:text-green-300';
        status.textContent = 'Message sent successfully!';
        status.classList.remove('hidden');
        form.reset();
      } else {
        throw new Error('Failed to send');
      }
    } catch {
      status.className = 'p-3 rounded-lg text-sm bg-red-50 dark:bg-red-900 text-red-700 dark:text-red-300';
      status.textContent = 'Failed to send. Please try again later.';
      status.classList.remove('hidden');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    }
  });
</script>
