---
import Base from '@layouts/Base.astro';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'zh';
---

<Base title={locale === 'zh' ? '注册' : 'Register'} description={locale === 'zh' ? '创建账户' : 'Create an account'} locale={locale}>
  <section class="max-w-md mx-auto px-4 py-20">
    <h1 class="text-2xl font-bold mb-8 text-center text-gray-900 dark:text-white">
      {locale === 'zh' ? '创建账户' : 'Create Account'}
    </h1>

    <form id="register-form" class="space-y-5">
      <div>
        <label for="name" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">{locale === 'zh' ? '姓名' : 'Name'}</label>
        <input type="text" id="name" name="name" required
          class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none transition" />
      </div>
      <div>
        <label for="email" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Email</label>
        <input type="email" id="email" name="email" required
          class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none transition" />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">{locale === 'zh' ? '密码' : 'Password'}</label>
        <input type="password" id="password" name="password" required minlength="8"
          class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none transition" />
        <p class="text-xs text-gray-400 mt-1">{locale === 'zh' ? '至少8个字符' : 'At least 8 characters'}</p>
      </div>
      <div>
        <label for="confirmPassword" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">{locale === 'zh' ? '确认密码' : 'Confirm Password'}</label>
        <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8"
          class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none transition" />
      </div>

      <div id="reg-status" class="hidden p-3 rounded-lg text-sm"></div>

      <button type="submit"
        class="w-full py-3 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors disabled:opacity-50">
        {locale === 'zh' ? '注册' : 'Register'}
      </button>

      <p class="text-center text-sm text-gray-500 dark:text-gray-400">
        {locale === 'zh' ? '已有账户？' : 'Already have an account? '}
        <a href={`/${locale}/login`} class="text-primary-600 dark:text-primary-400 hover:underline">{locale === 'zh' ? '登录' : 'Log in'}</a>
      </p>
    </form>
  </section>
</Base>

<script>
  const form = document.getElementById('register-form') as HTMLFormElement;
  const status = document.getElementById('reg-status')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const password = (document.getElementById('password') as HTMLInputElement).value;
    const confirmPassword = (document.getElementById('confirmPassword') as HTMLInputElement).value;
    if (password !== confirmPassword) {
      status.textContent = 'Passwords do not match';
      status.className = 'p-3 rounded-lg text-sm bg-red-50 dark:bg-red-900 text-red-700 dark:text-red-300';
      status.classList.remove('hidden');
      return;
    }
    const btn = form.querySelector('button')!;
    btn.disabled = true; btn.textContent = 'Registering…';
    try {
      const fd = new FormData(form);
      const res = await fetch('/api/register', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name: fd.get('name'), email: fd.get('email'), password: fd.get('password') }) });
      const data = await res.json();
      if (res.ok) {
        status.textContent = data.message || 'Account created! Please check your email to verify.';
        status.className = 'p-3 rounded-lg text-sm bg-green-50 dark:bg-green-900 text-green-700 dark:text-green-300';
        status.classList.remove('hidden');
        form.reset();
      } else {
        status.textContent = data.error || 'Registration failed';
        status.className = 'p-3 rounded-lg text-sm bg-red-50 dark:bg-red-900 text-red-700 dark:text-red-300';
        status.classList.remove('hidden');
      }
    } catch {
      status.textContent = 'Connection failed. Please try again.';
      status.className = 'p-3 rounded-lg text-sm bg-red-50 dark:bg-red-900 text-red-700 dark:text-red-300';
      status.classList.remove('hidden');
    } finally { btn.disabled = false; btn.textContent = 'Register'; }
  });
</script>
