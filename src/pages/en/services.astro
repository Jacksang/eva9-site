---
import Base from '@layouts/Base.astro';
import { t, type Locale } from '@lib/i18n';

const locale = (Astro.currentLocale ?? 'en') as Locale;
---

<Base
  title={locale === 'zh' ? '服务' : 'Services'}
  description={locale === 'zh' ? 'Jacky Chen 提供的技术服务' : 'Technical services offered by Jacky Chen'}
  locale={locale}
  ogType="website"
>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">
      {t('services.title', locale)}
    </h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mb-12">
      {t('services.subtitle', locale)}
    </p>

    <div class="grid md:grid-cols-2 gap-6 mb-16">
      <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-3xl mb-3">☁️</div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{t('services.cloud', locale)}</h3>
        <p class="text-gray-600 dark:text-gray-400">{t('services.cloud_desc', locale)}</p>
      </div>

      <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-3xl mb-3">🛒</div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{t('services.ecom', locale)}</h3>
        <p class="text-gray-600 dark:text-gray-400">{t('services.ecom_desc', locale)}</p>
      </div>

      <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-3xl mb-3">🧠</div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{t('services.cto', locale)}</h3>
        <p class="text-gray-600 dark:text-gray-400">{t('services.cto_desc', locale)}</p>
      </div>

      <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-primary-300 dark:hover:border-primary-700 hover:shadow-md transition-all">
        <div class="text-3xl mb-3">🤖</div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">{t('services.ai', locale)}</h3>
        <p class="text-gray-600 dark:text-gray-400">{t('services.ai_desc', locale)}</p>
      </div>
    </div>

    <!-- CTA -->
    <div class="text-center p-10 rounded-xl bg-gradient-to-br from-primary-50 to-blue-50 dark:from-primary-950 dark:to-gray-900 border border-primary-100 dark:border-primary-900">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-3">
        {t('services.cta', locale)}
      </h2>
      <p class="text-gray-600 dark:text-gray-400 mb-6 max-w-lg mx-auto">
        {locale === 'zh'
          ? '无论是完整的平台搭建、架构咨询，还是 AI 功能集成，我都可以帮助你。'
          : 'Whether it\'s a full platform build, architecture review, or AI feature integration — I can help.'}
      </p>
      <a
        href={`/${locale}/contact`}
        class="inline-block px-8 py-3 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors"
      >
        {t('services.cta_button', locale)}
      </a>
    </div>
  </section>
</Base>
