---
import AdminLayout from '@layouts/Admin.astro';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'zh';
---

<AdminLayout title={locale === 'zh' ? '管理面板' : 'Dashboard'} locale={locale}>
  <!-- Comments Tab -->
  <section id="tab-comments" class="tab-content p-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-bold">{locale === 'zh' ? '评论审核队列' : 'Comment Moderation Queue'}</h2>
      <select class="px-3 py-1.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-sm" id="comment-filter">
        <option value="all">{locale === 'zh' ? '全部' : 'All'}</option>
        <option value="pending" selected>{locale === 'zh' ? '待审核' : 'Pending'}</option>
        <option value="approved">{locale === 'zh' ? '已通过' : 'Approved'}</option>
        <option value="rejected">{locale === 'zh' ? '已拒绝' : 'Rejected'}</option>
      </select>
    </div>

    <div id="comment-list" class="space-y-3">
      <div class="text-center py-12 text-gray-500 dark:text-gray-400">
        <p class="text-lg">{locale === 'zh' ? '暂无评论' : 'No comments yet'}</p>
        <p class="text-sm mt-2">{locale === 'zh' ? '评论将在此处显示' : 'Comments will appear here'}</p>
      </div>
    </div>
  </section>

  <!-- Users Tab -->
  <section id="tab-users" class="tab-content p-6 hidden">
    <h2 class="text-xl font-bold mb-6">{locale === 'zh' ? '用户管理' : 'User Management'}</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200 dark:border-gray-700 text-left">
            <th class="pb-3 font-semibold text-gray-600 dark:text-gray-400">{locale === 'zh' ? '邮箱' : 'Email'}</th>
            <th class="pb-3 font-semibold text-gray-600 dark:text-gray-400">{locale === 'zh' ? '角色' : 'Role'}</th>
            <th class="pb-3 font-semibold text-gray-600 dark:text-gray-400">{locale === 'zh' ? '注册时间' : 'Registered'}</th>
            <th class="pb-3 font-semibold text-gray-600 dark:text-gray-400">{locale === 'zh' ? '操作' : 'Actions'}</th>
          </tr>
        </thead>
        <tbody id="user-list">
          <tr class="border-b border-gray-100 dark:border-gray-800">
            <td class="py-3 text-gray-500" colspan="4">{locale === 'zh' ? '暂无用户数据' : 'No user data available'}</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Messages Tab -->
  <section id="tab-messages" class="tab-content p-6 hidden">
    <h2 class="text-xl font-bold mb-6">{locale === 'zh' ? '联系消息' : 'Contact Messages'}</h2>
    <div class="space-y-3" id="message-list">
      <div class="text-center py-12 text-gray-500 dark:text-gray-400">
        <p class="text-lg">{locale === 'zh' ? '暂无消息' : 'No messages yet'}</p>
      </div>
    </div>
  </section>

  <!-- Analytics Tab -->
  <section id="tab-analytics" class="tab-content p-6 hidden">
    <h2 class="text-xl font-bold mb-6">{locale === 'zh' ? '数据分析' : 'Analytics'}</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class="p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <div class="text-3xl font-bold text-primary-600 dark:text-primary-400" id="stat-pageviews">--</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{locale === 'zh' ? '今日浏览' : 'Page Views Today'}</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <div class="text-3xl font-bold text-primary-600 dark:text-primary-400" id="stat-visitors">--</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{locale === 'zh' ? '独立访客' : 'Unique Visitors'}</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <div class="text-3xl font-bold text-primary-600 dark:text-primary-400" id="stat-comments">--</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{locale === 'zh' ? '总评论' : 'Total Comments'}</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <div class="text-3xl font-bold text-primary-600 dark:text-primary-400" id="stat-users">--</div>
        <div class="text-sm text-gray-500 dark:text-gray-400 mt-1">{locale === 'zh' ? '总用户' : 'Total Users'}</div>
      </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-6">
      <div class="p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <h3 class="font-semibold mb-3 text-sm text-gray-600 dark:text-gray-400">{locale === 'zh' ? '热门页面' : 'Top Pages'}</h3>
        <div id="top-pages" class="text-sm text-gray-500 dark:text-gray-400">{locale === 'zh' ? '暂无数据' : 'No data yet'}</div>
      </div>
      <div class="p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <h3 class="font-semibold mb-3 text-sm text-gray-600 dark:text-gray-400">{locale === 'zh' ? '最近访客' : 'Recent Visitors'}</h3>
        <div id="recent-visitors" class="text-sm text-gray-500 dark:text-gray-400">{locale === 'zh' ? '暂无数据' : 'No data yet'}</div>
      </div>
    </div>
  </section>
</AdminLayout>

<script>
  const API = '/api';
  const token = localStorage.getItem('eva9-admin-token');
  
  // Auth guard
  if (!token) {
    window.location.href = `/${'en'}/admin/login`;
  }

  const headers = { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` };

  // Tab switching
  function showTab(tab: string) {
    document.querySelectorAll('.tab-content').forEach((el: any) => el.classList.add('hidden'));
    document.getElementById('tab-' + tab)?.classList.remove('hidden');
    document.querySelectorAll('.admin-nav-item').forEach((el: any) => {
      el.classList.remove('bg-primary-50', 'dark:bg-primary-950', 'text-primary-700', 'dark:text-primary-300');
      el.classList.add('text-gray-600', 'dark:text-gray-400', 'hover:bg-gray-100', 'dark:hover:bg-gray-800');
    });
    const link = document.querySelector(`[href="#${tab}"]`);
    if (link) { link.classList.remove('text-gray-600', 'dark:text-gray-400'); link.classList.add('bg-primary-50', 'dark:bg-primary-950', 'text-primary-700', 'dark:text-primary-300'); }
    localStorage.setItem('eva9-admin-tab', tab);

    // Load data for the active tab
    if (tab === 'comments') loadComments();
    if (tab === 'users') loadUsers();
    if (tab === 'messages') loadMessages();
    if (tab === 'analytics') loadAnalytics();
  }

  // ─── Comments ───
  async function loadComments() {
    const status = (document.getElementById('comment-filter') as HTMLSelectElement)?.value || 'pending';
    try {
      const res = await fetch(`${API}/admin/comments?status=${status}`, { headers });
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();
      renderComments(data.comments || []);
    } catch {
      document.getElementById('comment-list')!.innerHTML = '<div class="text-center py-12 text-gray-500">Failed to load comments</div>';
    }
  }

  function renderComments(comments: any[]) {
    const list = document.getElementById('comment-list')!;
    if (!comments.length) {
      list.innerHTML = '<div class="text-center py-12 text-gray-500 dark:text-gray-400"><p class="text-lg">No comments</p></div>';
      return;
    }
    list.innerHTML = comments.map(c => `
      <div class="p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
        <div class="flex items-center justify-between mb-2">
          <div>
            <span class="font-medium">${c.authorName}</span>
            <span class="text-sm text-gray-500 ml-2">${c.authorEmail}</span>
          </div>
          <span class="text-xs px-2 py-0.5 rounded ${c.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : c.status === 'approved' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">${c.status}</span>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">${c.content}</p>
        <div class="text-xs text-gray-400 mb-3">On: ${c.postSlug} · ${new Date(c.createdAt).toLocaleString()}</div>
        ${c.status === 'pending' ? `
        <div class="flex gap-2">
          <button onclick="moderateComment('${c.id}', 'approve')" class="px-3 py-1 text-xs rounded bg-green-600 text-white hover:bg-green-700">Approve</button>
          <button onclick="moderateComment('${c.id}', 'reject')" class="px-3 py-1 text-xs rounded bg-red-600 text-white hover:bg-red-700">Reject</button>
        </div>` : ''}
      </div>
    `).join('');
  }

  async function moderateComment(id: string, action: string) {
    try {
      const res = await fetch(`${API}/admin/comments`, { method: 'PUT', headers, body: JSON.stringify({ id, action }) });
      if (res.ok) loadComments();
    } catch {}
  }
  (window as any).moderateComment = moderateComment;

  // ─── Users ───
  async function loadUsers() {
    try {
      const res = await fetch(`${API}/admin/users`, { headers });
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();
      renderUsers(data.users || []);
    } catch {
      document.getElementById('user-list')!.innerHTML = '<tr><td class="py-3 text-gray-500" colspan="4">Failed to load users</td></tr>';
    }
  }

  function renderUsers(users: any[]) {
    const tbody = document.getElementById('user-list')!;
    if (!users.length) {
      tbody.innerHTML = '<tr><td class="py-3 text-gray-500" colspan="4">No users yet</td></tr>';
      return;
    }
    tbody.innerHTML = users.map(u => `
      <tr class="border-b border-gray-100 dark:border-gray-800">
        <td class="py-2">${u.email}</td>
        <td class="py-2"><span class="text-xs px-2 py-0.5 rounded ${u.role === 'admin' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800'}">${u.role}</span></td>
        <td class="py-2 text-sm text-gray-500">${new Date(u.createdAt).toLocaleDateString()}</td>
        <td class="py-2 text-sm">${u.verified ? '✅' : '⏳'}</td>
      </tr>
    `).join('');
  }

  // ─── Messages ───
  async function loadMessages() {
    try {
      const res = await fetch(`${API}/admin/messages`, { headers });
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();
      renderMessages(data.messages || []);
    } catch {
      document.getElementById('message-list')!.innerHTML = '<div class="text-center py-12 text-gray-500">Failed to load messages</div>';
    }
  }

  function renderMessages(messages: any[]) {
    const list = document.getElementById('message-list')!;
    if (!messages.length) {
      list.innerHTML = '<div class="text-center py-12 text-gray-500"><p class="text-lg">No messages</p></div>';
      return;
    }
    list.innerHTML = messages.map(m => `
      <div class="p-4 rounded-xl bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 ${m.read ? 'opacity-60' : ''}">
        <div class="flex items-center justify-between mb-2">
          <span class="font-medium">${m.name}</span>
          <span class="text-xs text-gray-400">${new Date(m.createdAt).toLocaleString()}</span>
        </div>
        <p class="text-sm text-gray-500 mb-2">${m.email}</p>
        <p class="text-sm">${m.message}</p>
        ${!m.read ? `<button onclick="markRead('${m.id}')" class="mt-2 text-xs text-primary-600 hover:underline">Mark as read</button>` : ''}
      </div>
    `).join('');
  }

  async function markRead(id: string) {
    await fetch(`${API}/admin/messages`, { method: 'PUT', headers, body: JSON.stringify({ id }) });
    loadMessages();
  }
  (window as any).markRead = markRead;

  // ─── Analytics ───
  async function loadAnalytics() {
    try {
      const res = await fetch(`${API}/admin/visitors`, { headers });
      if (!res.ok) throw new Error('Failed');
      const data = await res.json();
      document.getElementById('stat-pageviews')!.textContent = String(data.stats?.pageViews ?? '--');
      document.getElementById('stat-visitors')!.textContent = String(data.stats?.uniqueVisitors ?? '--');
      document.getElementById('stat-comments')!.textContent = String(data.stats?.totalComments ?? '--');
      document.getElementById('stat-users')!.textContent = String(data.stats?.totalUsers ?? '--');
      document.getElementById('top-pages')!.innerHTML = (data.topPages || []).map((p: any) => `<div class="flex justify-between py-1"><span>${p.page}</span><span>${p.views}</span></div>`).join('') || 'No data yet';
      document.getElementById('recent-visitors')!.innerHTML = (data.recentVisitors || []).slice(0, 10).map((v: any) => `<div class="flex justify-between py-1 text-xs"><span>${v.ip}</span><span>${v.page}</span><span>${new Date(v.timestamp).toLocaleTimeString()}</span></div>`).join('') || 'No data yet';
    } catch {
      // Silently fail for analytics
    }
  }

  // Filter change
  document.getElementById('comment-filter')?.addEventListener('change', loadComments);

  // Logout
  document.getElementById('admin-logout')?.addEventListener('click', () => {
    localStorage.removeItem('eva9-admin-token');
    window.location.href = '/en/admin/login';
  });

  // Init: restore last tab
  const savedTab = localStorage.getItem('eva9-admin-tab') || 'comments';
  showTab(savedTab);
</script>
