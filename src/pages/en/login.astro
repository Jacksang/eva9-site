---
import Base from '@layouts/Base.astro';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'zh';
---

<Base title={locale === 'zh' ? '登录' : 'Log in'} description={locale === 'zh' ? '登录你的账户' : 'Log in to your account'} locale={locale}>
  <section class="max-w-md mx-auto px-4 py-20">
    <h1 class="text-2xl font-bold mb-8 text-center text-gray-900 dark:text-white">
      {locale === 'zh' ? '登录' : 'Log in'}
    </h1>

    <form id="login-form" class="space-y-5">
      <div>
        <label for="email" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">Email</label>
        <input type="email" id="email" name="email" required
          class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none transition" />
      </div>
      <div>
        <label for="password" class="block text-sm font-medium mb-1 text-gray-700 dark:text-gray-300">{locale === 'zh' ? '密码' : 'Password'}</label>
        <input type="password" id="password" name="password" required
          class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 outline-none transition" />
      </div>

      <div id="login-status" class="hidden p-3 rounded-lg text-sm"></div>

      <button type="submit"
        class="w-full py-3 rounded-lg bg-primary-600 text-white font-medium hover:bg-primary-700 transition-colors disabled:opacity-50">
        {locale === 'zh' ? '登录' : 'Log in'}
      </button>

      <p class="text-center text-sm text-gray-500 dark:text-gray-400">
        {locale === 'zh' ? '没有账户？' : "Don't have an account? "}
        <a href={`/${locale}/register`} class="text-primary-600 dark:text-primary-400 hover:underline">{locale === 'zh' ? '注册' : 'Register'}</a>
      </p>
    </form>
  </section>
</Base>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement;
  const status = document.getElementById('login-status')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button')!;
    btn.disabled = true; btn.textContent = 'Logging in…';
    try {
      const fd = new FormData(form);
      const res = await fetch('/api/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: fd.get('email'), password: fd.get('password') }) });
      const data = await res.json();
      if (res.ok) {
        localStorage.setItem('eva9-user-token', data.token);
        localStorage.setItem('eva9-user-name', data.name || '');
        window.location.reload();
      } else {
        status.textContent = data.error || 'Invalid credentials';
        status.className = 'p-3 rounded-lg text-sm bg-red-50 dark:bg-red-900 text-red-700 dark:text-red-300';
        status.classList.remove('hidden');
      }
    } catch {
      status.textContent = 'Connection failed. Please try again.';
      status.className = 'p-3 rounded-lg text-sm bg-red-50 dark:bg-red-900 text-red-700 dark:text-red-300';
      status.classList.remove('hidden');
    } finally { btn.disabled = false; btn.textContent = 'Log in'; }
  });
</script>
