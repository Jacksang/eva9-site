---
import Base from '@layouts/Base.astro';
import { t, type Locale } from '@lib/i18n';

const locale = (Astro.currentLocale ?? 'zh') as Locale;

const studies = [
  {
    titleKey: 'studies.mit',
    titleZh: 'MIT 认证',
    descKey: 'studies.mit_desc',
    descZh: '机器学习与人工智能专业证书',
    status: 'in_progress',
    items: ['机器学习与 Python', '深度学习基础', 'AI 伦理与治理'],
  },
  {
    titleKey: 'studies.great_learning',
    titleZh: 'Great Learning',
    descKey: 'studies.great_learning_desc',
    descZh: '无代码机器学习与数据科学课程',
    status: 'in_progress',
    items: ['无代码机器学习基础', '数据科学与分析', 'AI 商业应用'],
  },
];
---

<Base
  title={'学习'}
  description={'Jacky Chen 的学习历程'}
  locale={locale}
  ogType="website"
>
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-2">
      {locale === 'zh' ? '学习' : 'Studies'}
    </h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mb-12">
      {locale === 'zh' ? '持续学习 — AI、数据科学、不断前进。' : 'Continuous learning — AI, data science, and beyond.'}
    </p>

    <div class="grid md:grid-cols-2 gap-6">
      {studies.map(study => (
        <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-800 hover:shadow-md transition-all">
          <div class="flex items-start justify-between mb-4">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white">
              {locale === 'zh' ? study.titleZh : t(study.titleKey, locale)}
            </h2>
            <span class="shrink-0 px-3 py-1 text-xs font-medium rounded-full bg-yellow-100 dark:bg-yellow-900 text-yellow-700 dark:text-yellow-300">
              {locale === 'zh' ? '进行中' : 'In Progress'}
            </span>
          </div>
          <p class="text-gray-500 dark:text-gray-400 mb-4">
            {locale === 'zh' ? study.descZh : t(study.descKey, locale)}
          </p>
          <ul class="space-y-2">
            {study.items.map(item => (
              <li class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
                <span class="text-primary-500">◆</span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Future plans -->
    <div class="mt-12 p-6 rounded-xl border border-gray-200 dark:border-gray-800">
      <h2 class="text-lg font-bold text-gray-900 dark:text-white mb-3">
        {locale === 'zh' ? '学习方向' : 'Learning Direction'}
      </h2>
      <p class="text-gray-600 dark:text-gray-300">
        {locale === 'zh'
          ? '持续深入 AI 与数据科学领域，探索 LLM 在实际产品中的应用。同时关注云原生架构与系统设计的最新发展。'
          : 'Deepening expertise in AI and data science, exploring practical LLM applications in products. Also tracking latest developments in cloud-native architecture and system design.'}
      </p>
    </div>
  </section>
</Base>
