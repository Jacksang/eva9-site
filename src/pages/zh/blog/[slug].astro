---
import BlogPostLayout from '@layouts/BlogPost.astro';
import { generateBlogPostJSONLD } from '@lib/seo';

export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/blog/zh/*.md', { eager: true });
  return Object.entries(posts).map(([, post]: [string, any]) => ({
    params: { slug: post.frontmatter.slug },
  }));
}

const { slug } = Astro.params;

const allPosts = import.meta.glob('../../content/blog/zh/*.md', { eager: true });
const post = Object.values(allPosts).find((p: any) => p.frontmatter.slug === slug) as any;
if (!post) {
  return Astro.redirect('/zh/blog');
}

const { frontmatter, compiledContent } = post;
const { title, excerpt, pubDate, category, readingTime, ogImage } = frontmatter;

const currentURL = new URL(Astro.url.pathname, Astro.site).href;
const jsonld = generateBlogPostJSONLD({
  title,
  description: excerpt,
  image: ogImage,
  url: currentURL,
  publishedDate: pubDate,
  authorName: 'Jacky Chen',
});
---

<BlogPostLayout
  title={title}
  description={excerpt}
  locale="zh"
  ogImage={ogImage}
  publishedDate={pubDate}
  category={category}
  readingTime={readingTime ?? Math.ceil((compiledContent?.length ?? 0) / 500)}
>
  <script type="application/ld+json" is:inline set:html={jsonld} />
  {compiledContent}
</BlogPostLayout>
