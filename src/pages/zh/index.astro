---
import Base from '@layouts/Base.astro';
import PostCard from '@components/PostCard.astro';
import { t } from '@lib/i18n';

const locale = (Astro.currentLocale ?? 'zh') as 'en' | 'zh';

const enPosts = Object.values(import.meta.glob('../../content/blog/en/*.md', { eager: true })) as any[];
const zhPosts = Object.values(import.meta.glob('../../content/blog/zh/*.md', { eager: true })) as any[];
const posts = locale === 'en' ? enPosts : zhPosts;
const sortedPosts = posts
  .sort((a, b) => (b.frontmatter.pubDate?.getTime?.() ?? 0) - (a.frontmatter.pubDate?.getTime?.() ?? 0))
  .slice(0, 6);

const categories = [
  { key: 'category.work', icon: '💼', descEn: 'Consulting & Tech', descZh: '咨询与技术', slug: 'work' },
  { key: 'category.learn', icon: '📚', descEn: 'Courses & Study', descZh: '课程与学习', slug: 'learn' },
  { key: 'category.hobby', icon: '🎨', descEn: 'Creative Projects', descZh: '创意项目', slug: 'hobby' },
  { key: 'category.life', icon: '🌿', descEn: 'Reflections & Stories', descZh: '思考与故事', slug: 'life' },
];
---

<Base
  title="Jacky Chen"
  description={locale === 'zh' ? '云端电商架构师的个人博客' : 'Personal blog of a cloud e-commerce architect'}
  locale={locale}
  ogType="website"
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "name": "Jacky Chen",
    "url": "https://blog.eva9.ai",
    "jobTitle": locale === 'zh' ? '云端电商架构师' : 'Cloud E-Commerce Architect',
    "sameAs": [
      "https://github.com/Jacksang",
      "https://linkedin.com/in/shengch"
    ]
  })} />

  <!-- ========================================
       Hero Section – Split-screen layout
       ======================================== -->
  <section class="relative min-h-[100dvh] flex items-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-50/40 via-white to-gray-50 dark:from-gray-950 dark:via-gray-950 dark:to-primary-950/20 pointer-events-none" />

    <div class="relative z-10 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-0">
      <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-16">
        <!-- Left: Text -->
        <div class="flex-1 text-center lg:text-left max-w-xl">
          <p class="reveal visible inline-flex items-center gap-1.5 px-3 py-1 mb-6 text-xs font-medium tracking-wider uppercase text-primary-700 dark:text-primary-300 bg-primary-50 dark:bg-primary-950/60 rounded-full">
            <span class="w-1.5 h-1.5 rounded-full bg-primary-500" />
            20年规模化构建经验
          </p>
          <h1 class="reveal visible text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.08] text-gray-900 dark:text-white">
            {t('hero.title', locale)}
          </h1>
          <p class="reveal visible reveal-delay-1 mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 leading-relaxed max-w-lg lg:mx-0">
            {t('hero.subtitle', locale)}
          </p>
          <div class="reveal visible reveal-delay-2 flex flex-wrap gap-3 justify-center lg:justify-start mt-8">
            <a
              href={`/${locale}/about`}
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary-600 text-white font-medium hover:bg-primary-700 active:scale-[0.97] transition-all shadow-sm hover:shadow-md"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              {t('hero.about', locale)}
            </a>
            <a
              href={`/${locale}/contact`}
              class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-400 font-medium hover:border-gray-300 dark:hover:border-gray-600 hover:text-gray-800 dark:hover:text-gray-200 active:scale-[0.97] transition-all"
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              {t('hero.services', locale)}
            </a>
          </div>
          <!-- Social proof strip -->
          <div class="reveal visible reveal-delay-3 mt-10 flex items-center gap-4 text-xs text-gray-400 dark:text-gray-500">
            <span class="font-medium text-gray-500 dark:text-gray-400">GitHub</span>
            <a href="https://github.com/Jacksang" target="_blank" rel="noopener noreferrer" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Jacksang</a>
            <span class="w-px h-3 bg-gray-300 dark:bg-gray-700" />
            <span class="font-medium text-gray-500 dark:text-gray-400">LinkedIn</span>
            <a href="https://linkedin.com/in/shengch" target="_blank" rel="noopener noreferrer" class="hover:text-primary-600 dark:hover:text-primary-400 transition-colors">shengch</a>
          </div>
        </div>

        <!-- Right: Visual mark -->
        <div class="flex-shrink-0 reveal visible reveal-delay-2">
          <div class="relative">
            <div class="absolute inset-0 rounded-full bg-primary-200/30 dark:bg-primary-800/20 blur-3xl" />
            <div class="relative w-56 h-56 lg:w-72 lg:h-72 rounded-full bg-gradient-to-br from-primary-400 to-primary-700 dark:from-primary-500 dark:to-primary-800 flex items-center justify-center shadow-2xl">
              <span class="text-7xl lg:text-8xl font-bold text-white/90 tracking-tight" style="font-family: 'Geist', sans-serif;">JC</span>
            </div>
            <div class="absolute -top-3 -right-3 w-6 h-6 rounded-full bg-primary-300 dark:bg-primary-600 animate-pulse" />
            <div class="absolute -bottom-2 -left-2 w-4 h-4 rounded-full bg-amber-300 dark:bg-amber-600" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================
       Category Grid – Asymmetric bento layout
       ======================================== -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-24">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      {categories.map((cat, i) => {
        const spans = [
          'md:col-span-2 md:row-span-1',
          'md:col-span-1 md:row-span-1',
          'md:col-span-1 md:row-span-2',
          'md:col-span-2 md:row-span-1',
        ];
        return (
          <a
            href={`/${locale}/blog?category=${cat.slug}`}
            class={`group relative overflow-hidden rounded-2xl border border-gray-200/70 dark:border-gray-800/70 hover:border-primary-300/50 dark:hover:border-primary-700/50 hover:shadow-lg transition-all duration-300 reveal ${spans[i]}`}
          >
            <div class="p-6 md:p-8 h-full flex flex-col">
              <div class="mb-4 w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-950/50 flex items-center justify-center group-hover:bg-primary-100 dark:group-hover:bg-primary-900/40 transition-colors">
                {cat.icon === '💼' && (
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                )}
                {cat.icon === '📚' && (
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                )}
                {cat.icon === '🎨' && (
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                )}
                {cat.icon === '🌿' && (
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
                )}
              </div>
              <h3 class="font-semibold text-lg text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {t(cat.key, locale)}
              </h3>
              <p class="text-sm text-gray-500 dark:text-gray-400 mt-1 leading-relaxed">
                {locale === 'zh' ? cat.descZh : cat.descEn}
              </p>
            </div>
            <div class="absolute -top-6 -right-6 w-12 h-12 rounded-full bg-primary-100/50 dark:bg-primary-900/20 group-hover:bg-primary-200/60 dark:group-hover:bg-primary-800/30 transition-colors" />
          </a>
        );
      })}
    </div>
  </section>

  <!-- ========================================
       Recent Posts
       ======================================== -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-24">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
          {t('blog.recent', locale)}
        </h2>
        <p class="mt-2 text-sm text-gray-400 dark:text-gray-500">
          关于云架构、电商与生活的思考
        </p>
      </div>
      <a
        href={`/${locale}/blog`}
        class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors group"
      >
        {t('blog.read_more', locale)}
        <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>

    {sortedPosts.length > 0 ? (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {sortedPosts.map((post: any, i: number) => (
          <PostCard
            title={post.frontmatter.title}
            slug={post.frontmatter.slug}
            category={post.frontmatter.category}
            pubDate={post.frontmatter.pubDate}
            excerpt={post.frontmatter.excerpt}
            readingTime={post.frontmatter.readingTime}
            locale={locale}
            index={i}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
          <svg class="w-6 h-6 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/></svg>
        </div>
        <p class="text-gray-400 dark:text-gray-500">{t('blog.no_posts', locale)}</p>
      </div>
    )}

    <div class="mt-8 text-center sm:hidden">
      <a
        href={`/${locale}/blog`}
        class="inline-flex items-center gap-1.5 text-sm font-medium text-primary-600 dark:text-primary-400"
      >
        {t('blog.read_more', locale)}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
      </a>
    </div>
  </section>
</Base>
